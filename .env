# Application
APP_NAME=ITL AI Backend
APP_ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string

# Server
HOST=0.0.0.0
PORT=8000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=itl_ai_db
DB_USER=itl_admin
DB_PASSWORD=itl_admin_password

DATABASE_URL=postgresql://itl_admin:itl_admin_password@postgres:5432/itl_ai_db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Services (for later)
ASK_BOT_URL=
JUDGEMENT_BOT_URL=
NOTICE_REPLY_URL=
SUMMARIZER_URL=