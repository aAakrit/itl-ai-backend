# Application
APP_NAME=ITL AI Backend
APP_ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string

# Server
HOST=0.0.0.0
PORT=8000

# Database
DB_HOST=postgres
DB_PORT=5432
